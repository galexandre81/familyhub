# Modèle de apps/hub/.env.local (copier, puis remplir ; ce fichier-là n'est jamais versionné).
# Le pré-remplissage du livre de recettes a son propre modèle : scripts/seedRecipes/.env.example

# Hub React (Vite — préfixées VITE_) — OBLIGATOIRES, le build échoue sans elles.
# Récupère les valeurs dans Firebase Console → Project settings → General → Your apps → Web app config
# Connexion depuis l'application installée sur iPhone : voir docs/DESIGN.md § Téléphone (AUTH_DOMAIN).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=family-hub-TONNOM.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=family-hub-TONNOM
VITE_FIREBASE_STORAGE_BUCKET=family-hub-TONNOM.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ces mêmes VITE_FIREBASE_* servent aussi à générer la config de l'iPad
# (apps/hub/dist/display/js/firebase-config.js) au moment du build.

# FACULTATIVES — déclarées dans apps/hub/src/lib/env.d.ts mais lues nulle part
# dans le code actuel (au 26.10.2026). Peuvent rester vides.
VITE_HUB_URL=https://family-hub-TONNOM.web.app
VITE_DISPLAY_URL=https://family-hub-TONNOM.web.app/display
VITE_GOOGLE_CALENDAR_CLIENT_ID=
