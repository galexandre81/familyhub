rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // setupShortIds : lookup table accédée uniquement via Admin SDK (Cloud Functions).
    // Les clients web/display passent par les Functions (exchangeSetupToken) qui bypassent ces rules.
    match /setupShortIds/{shortId} {
      allow read, write: if false;
    }

    // Invitations dans un foyer : créées et consommées uniquement par les
    // Functions (createInvitation / acceptInvitation). Un client ne lit pas un
    // code (il donnerait accès au foyer) et ne le marque pas utilisé.
    match /invitations/{code} {
      allow read, write: if false;
    }

    // Users : chacun lit/écrit son propre doc
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Helpers : un display authentifié via custom token a le claim isDisplay=true et son householdId.
    function isMember(hid) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.membres;
    }
    // Rôles à la création d'un foyer : seulement { <moi>: 'parent' }. Les rôles
    // des autres membres ne s'ajoutent que par acceptInvitation (Function).
    function rolesDuFondateur(roles) {
      return roles is map
        && roles.size() == 1
        && roles.keys().hasOnly([request.auth.uid])
        && roles[request.auth.uid] == 'parent';
    }
    function isDisplayOfHousehold(hid) {
      return request.auth != null
        && request.auth.token.isDisplay == true
        && request.auth.token.householdId == hid;
    }

    // Households : membres lisent/écrivent. Displays peuvent lire, jamais
    // modifier (le thème n'existe plus : ambiance jour/nuit automatique).
    match /households/{hid} {
      allow read: if request.auth != null
                  && (request.auth.uid in resource.data.membres
                      || isDisplayOfHousehold(hid));
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.membres
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.membres == resource.data.membres
                    && request.resource.data.get('roles', null) == resource.data.get('roles', null);
      // Création : un vrai compte (jamais un écran), seul membre de son foyer.
      // Sans cette garde, n'importe qui pouvait créer un foyer en y inscrivant
      // l'uid d'un autre dans `membres` : le foyer apparaissait chez la victime.
      allow create: if request.auth != null
                    && request.auth.token.get('isDisplay', false) != true
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.membres == [request.auth.uid]
                    && request.resource.data.keys().hasOnly(
                         ['nom', 'ownerUid', 'membres', 'roles', 'parametres', 'createdAt', 'updatedAt'])
                    && request.resource.data.nom is string
                    && (!('roles' in request.resource.data) || rolesDuFondateur(request.resource.data.roles));
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // Timers : displays peuvent aussi écrire (création/pause/stop depuis l'iPad cuisine).
      match /timers/{timerId} {
        allow read, write: if isMember(hid) || isDisplayOfHousehold(hid);
      }

      // Recettes : membres = read/write. Les displays (tuile recette du jour)
      // votent en écrivant statut/excluded/updatedAt sur le doc recette.
      // Firestore autorise dès qu'UNE règle correspondante l'autorise : ce
      // bloc spécifique s'ajoute au catch-all foyer-scope ci-dessous.
      match /recettes/{recetteId} {
        allow read: if isMember(hid) || isDisplayOfHousehold(hid);
        allow write: if isMember(hid);
        allow update: if isMember(hid)
                      || (
                        isDisplayOfHousehold(hid)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'excluded', 'updatedAt'])
                      );
      }

      // Catch-all foyer-scope : MEMBRES uniquement (read + write) sur toutes les
      // sous-collections, y compris profils, mealPlans, mealPlans/{id}/slots,
      // coursesItems, etc. — qui contiennent des données médicales/sensibles.
      //
      // IMPORTANT : ce catch-all n'accorde AUCUN accès aux displays. Les rules
      // Firestore sont OR-combinées : pour qu'un display ne puisse PAS lire
      // profils/mealPlans, aucune règle correspondante ne doit l'autoriser. La
      // lecture display est donc accordée explicitement, collection par
      // collection, dans les blocs ci-dessous (tiles, displays, shoppingLists),
      // ainsi que dans les blocs recettes et timers définis plus haut.
      //
      // L'enforcement de checkedAt/checkedBy au cochage d'un item de courses est
      // porté côté client (l'array `items` est dans le doc parent, non validable
      // par élément côté rules).
      match /{collection}/{docId=**} {
        allow read, write: if isMember(hid);
      }

      // Tiles : configuration/données des tuiles affichées sur l'iPad.
      // Membres = read/write (via catch-all). Displays = read (ici) + changement
      // de la ville météo : seulement config.selectedLocationId (+ updatedAt),
      // tel qu'écrit par l'iPad (update avec chemin pointé 'config.selectedLocationId').
      match /tiles/{tileId=**} {
        allow read: if isDisplayOfHousehold(hid);
        allow update: if isDisplayOfHousehold(hid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['config', 'updatedAt'])
                      && request.resource.data.config.diff(resource.data.config).affectedKeys().hasOnly(['selectedLocationId'])
                      && request.resource.data.config.selectedLocationId is string
                      && request.resource.data.config.selectedLocationId.size() <= 100;
      }

      // Shopping lists : le display affiche la liste de courses (lecture seule).
      // Membres = read/write (via catch-all). Displays = read seul (ici).
      match /shoppingLists/{docId=**} {
        allow read: if isDisplayOfHousehold(hid);
      }

      // Displays : un écran lit SON propre doc de config ET son snapshot
      // pré-calculé (sous-collection snapshot/current), jamais ceux des autres
      // écrans du foyer : le doc display porte l'authToken et le setupToken.
      // Membres = read/write (via catch-all). Displays = read seul (ici).
      match /displays/{displayId} {
        allow read: if isDisplayOfHousehold(hid)
                    && request.auth.token.displayId == displayId;
      }
      match /displays/{displayId}/{rest=**} {
        allow read: if isDisplayOfHousehold(hid)
                    && request.auth.token.displayId == displayId;
      }

      // private/calendar : l'adresse iCal secrète du foyer. Membres seulement
      // (via le catch-all) — aucune règle ne l'ouvre aux écrans, c'est voulu.
    }

    // ─── Contrôle parental : appareils pilotés (le PC des enfants) ───────────
    // Collection RACINE, hors du foyer : le catch-all des membres ci-dessus ne
    // s'y applique pas, rien d'existant ne change. Noms de champs et valeurs :
    // packages/controle-parental/src/schema.ts (un test vérifie qu'ils
    // concordent). Family Hub ne bloque rien : il fixe les règles, l'appareil
    // les applique.
    //   - L'APPAREIL (compte Firebase Auth dédié, reconnu par `deviceUid` dans
    //     sa config) lit sa config ; il écrit status/current, usage/{jour} et
    //     crée ses demandes. Rien d'autre.
    //   - Les PARENTS du foyer `householdId` lisent tout, écrivent la config et
    //     le statut des demandes. Ni les écrans, ni un membre non parent.
    // Parent : membre du foyer avec le rôle parent ; foyer ancien sans `roles`,
    // tout membre (même règle que estParent dans le hub).
    function parentDe(hid) {
      let foyer = get(/databases/$(database)/documents/households/$(hid)).data;
      return request.auth != null
        && request.auth.token.get('isDisplay', false) != true
        && request.auth.uid in foyer.membres
        && (foyer.get('roles', null) == null
            || foyer.roles.get(request.auth.uid, null) == 'parent');
    }

    match /devices/{deviceId} {
      function config() {
        return get(/databases/$(database)/documents/devices/$(deviceId)).data;
      }
      function estAppareil() {
        return request.auth != null && config().get('deviceUid', null) == request.auth.uid;
      }
      function estParent() {
        return parentDe(config().householdId);
      }
      // Config écrite par un parent : champs connus, signée par lui, et toute
      // exception porte une échéance (sinon elle ne finirait jamais).
      function configValide(d) {
        return d.keys().hasOnly(['householdId', 'deviceUid', 'name', 'schedule', 'defaults',
                                 'override', 'schoolAllowlist', 'apps', 'categoryLimits',
                                 'updatedAt', 'updatedBy'])
          && d.householdId is string
          && d.get('updatedBy', null) == request.auth.uid
          && (d.get('override', null) == null || d.override.until is timestamp)
          && (!('schoolAllowlist' in d) || d.schoolAllowlist is list);
      }

      allow get: if request.auth != null
                 && (resource.data.get('deviceUid', null) == request.auth.uid
                     || parentDe(resource.data.householdId));
      allow list: if parentDe(resource.data.householdId);
      allow create: if parentDe(request.resource.data.householdId)
                    && configValide(request.resource.data);
      allow update: if parentDe(resource.data.householdId)
                    && request.resource.data.householdId == resource.data.householdId
                    && configValide(request.resource.data);
      allow delete: if parentDe(resource.data.householdId);

      // État effectif : un seul document, écrit par l'appareil seul.
      match /status/{docId} {
        allow read: if estParent() || estAppareil();
        allow write: if estAppareil() && docId == 'current';
      }

      // Usage d'une journée, id AAAA-MM-JJ, écrit par l'appareil seul.
      match /usage/{jour} {
        allow read: if estParent() || estAppareil();
        allow create, update: if estAppareil() && jour.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      // Demandes : l'appareil les crée en attente ; un parent ne pose que la
      // décision, signée de son uid. Personne ne supprime.
      match /requests/{requestId} {
        allow read: if estParent() || estAppareil();
        allow create: if estAppareil()
                      && request.resource.data.get('status', null) == 'pending'
                      && !('decidedBy' in request.resource.data);
        allow update: if estParent()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'decidedBy', 'decidedAt', 'grantedUntil'])
                      && request.resource.data.status in ['accepted', 'refused']
                      && request.resource.data.decidedBy == request.auth.uid;
      }
    }
  }
}
